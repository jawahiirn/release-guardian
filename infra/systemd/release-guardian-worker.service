[Unit]
Description=Release Guardian worker
After=network-online.target postgresql.service release-guardian-api.service
Wants=network-online.target

[Service]
Type=simple
User=release-guardian
WorkingDirectory=/opt/release-guardian
EnvironmentFile=/etc/release-guardian/release-guardian.env
ExecStart=/usr/local/bin/uv run python -m apps.worker.app.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
